# DeFlow Labs — Marketing Website Environment Variables

# Sanity CMS — public configuration
NUXT_SANITY_PROJECT_ID=i34vbeac
NUXT_SANITY_DATASET=production
NUXT_SANITY_API_VERSION=2026-08-17
NUXT_SANITY_STUDIO_ORIGIN=http://localhost:3333
# Server-only secret: least-privilege Viewer token used to validate
# Presentation secrets and read drafts.
SANITY_API_READ_TOKEN=

# Cloudflare Turnstile (bot protection)
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (transactional email for contact form)
RESEND_API_KEY=
CONTACT_EMAIL=contact@deflowlabs.io

# Site URL
NUXT_PUBLIC_SITE_URL=https://deflowlabs.io

# Server-only stable HMAC key for waitlist email hashing. Rotating it changes
# deduplication and therefore requires a planned data migration.
PII_SALT_SECRET=

# Vercel Postgres (Neon) — auto-injected by Vercel when Storage is connected
POSTGRES_URL=
